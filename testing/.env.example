# Where the running application lives. Nothing here is spawned by the suite.
E2E_BASE_URL=http://localhost:5173
E2E_API_URL=http://localhost:4000/api/v1

# Accounts the suite owns. Created by: npm run setup
E2E_ADMIN_EMAIL=e2e.admin@leave.test
E2E_ADMIN_PASSWORD=change-me-to-a-policy-valid-password
E2E_ADMIN_ROLE=super_admin

E2E_LIMITED_EMAIL=e2e.employee@leave.test
E2E_LIMITED_PASSWORD=change-me-too
E2E_LIMITED_ROLE=employee

# Comma separated. The suite refuses to run if it logs in as one of these.
E2E_PROTECTED_EMAILS=

# Throwaway accounts created during the users suite live under this domain.
E2E_USER_EMAIL_DOMAIN=leave.test

# Optional
E2E_SLOW_MO=0
E2E_ELEMENT_TIMEOUT=12000
E2E_TOAST_TIMEOUT=8000
