NODE_ENV=development

HOST=0.0.0.0
PORT=4000

FRONTEND_URL=http://localhost:5173

DB_HOST=YOUR_MYSQL_CONTAINER_IP
DB_PORT=3306
DB_NAME=leave_management
DB_USER=YOUR_DB_USER
DB_PASSWORD=YOUR_DB_PASSWORD

REDIS_HOST=YOUR_REDIS_CONTAINER_IP
REDIS_PORT=6379
REDIS_PASSWORD=

SESSION_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
CSRF_SECRET=PASTE_A_NEW_RANDOM_SECRET_HERE

# Required to save encrypted secret settings such as SMTP credentials.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
ENCRYPTION_KEY=

GLOBAL_RATE_LIMIT_WINDOW_MS=900000
GLOBAL_RATE_LIMIT_MAX=300

# Login rate limiter
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=100

# Sensitive admin operations rate limiter
SENSITIVE_RATE_LIMIT_WINDOW_MS=900000
SENSITIVE_RATE_LIMIT_MAX=20

# Cloudflare Turnstile Configuration
# For local development with guaranteed pass on any domain (including localhost):
# SITE_KEY=1x00000000000000000000AA
# SECRET_KEY=1x0000000000000000000000000000000AA
SITE_KEY=          # cloudflare turnstile site key
SECRET_KEY=       # cloudflare turnstile secret key
# Optional override: set true/false to force enable/disable without touching DB
# TURNSTILE_ENABLED=false

TEST_EMAIL=your_email
TEST_PASSWORD=set_password_for_testing # Test@99999
